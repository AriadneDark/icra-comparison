# Copy to benchmark/docker.env and keep it outside version control/public logs.
HF_TOKEN=hf_replace_me

# One hosted OpenAI-compatible multimodal model is used for SVG2 stages 5-6.
# Keep the exact model id and /v1 base URL provided by your API vendor.
SVG2_API_KEY=replace_me
SVG2_API_KEY_ENV=SVG2_API_KEY
SVG2_API_BASE_URL=REPLACE_WITH_OPENAI_COMPATIBLE_BASE_URL
SVG2_API_MODEL=Qwen/Qwen3.8-27B
SVG2_API_CONCURRENCY=4

# Prefer a model family independent from the Qwen models used by the evaluated
# pipelines. If blank, evaluation falls back to the SVG2 API above and records
# judge_independent_of_qwen_generators=false in every artifact.
EVAL_VLM_API_KEY=
EVAL_VLM_BASE_URL=
EVAL_VLM_MODEL=

# Independent local judge for an A100 80 GB. No API key is required.
# The vLLM image is pinned so the evaluation environment is reproducible.
GEMMA_JUDGE_IMAGE=vllm/vllm-openai:v0.29.0-cu129
GEMMA_JUDGE_MODEL=google/gemma-4-31B-it
GEMMA_JUDGE_PORT=8000
GEMMA_JUDGE_MAX_MODEL_LEN=8192
GEMMA_JUDGE_MAX_NUM_SEQS=1
GEMMA_JUDGE_GPU_MEMORY_UTILIZATION=0.95

# Optional fallback when using OpenAI directly instead of the endpoint above.
OPENAI_API_KEY=

# One physical GPU index. Docker passes only this device to the Gemma judge.
NVIDIA_VISIBLE_DEVICES=0

# Persistent host caches. Relative paths are resolved from benchmark/.
HF_CACHE_DIR=./.cache/huggingface
TORCH_CACHE_DIR=./.cache/torch

# Optional external input tree; mounted read-only at /input/scenes.
BENCHMARK_HOST_SOURCE_ROOT=../our_results/scenes
